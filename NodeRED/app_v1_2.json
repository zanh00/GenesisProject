    {
        "id": "400ec030b87ed52c",
        "type": "function",
        "z": "4522ec776ef79fb7",
        "name": "Set Steering Angle",
        "func": "// Retrieve stored value from context\nlet storedValue = context.get(\"storedValue\") || 0;\n\n// Check if the message is coming from the numeric input\nif (msg.topic === \"SteerAng\") {\n    context.set(\"storedValue\", msg.payload);\n    return null;  // Do not send any output yet\n}\n\n// Check if the message is coming from the button click\nif (msg.topic === \"trigger\") {\n    let angle = parseInt(context.get(\"storedValue\"))\n    msg.payload = {\n    dataID: 9,\n    data: angle\n    };\n    return msg;\n}\n\n// If neither condition is met, do nothing\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
