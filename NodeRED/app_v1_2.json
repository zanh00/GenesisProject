    {
        "id": "d311f9165228a992",
        "type": "function",
        "z": "a5e59851dbab1674",
        "name": "Deserializer",
        "func": "// Input: msg.payload (e.g., \"0512345678\")\n\n// Extract the first two characters (data ID as ASCII nibbles)\nlet dataIDHex = msg.payload.slice(0, 2); // \"05\"\n// Convert the data ID from hexadecimal (ASCII nibbles) to a number\nlet dataID = parseInt(dataIDHex, 16); // 5\n\n// Extract the remaining 8 characters (data)\nlet dataStr = msg.payload.slice(2); // \"12345678\"\n\nlet data; // Variable to hold the parsed data\n\nif (dataID >= 128) {\n    // Parse data as a floating-point number if dataID >= 128\n\n    // Convert hex string to a 32-bit unsigned integer\n    let intVal = parseInt(dataStr, 16);\n\n    // Create a buffer to interpret the integer as a float\n    let buffer = new ArrayBuffer(4); // 4 bytes for a 32-bit float\n    let intView = new Uint32Array(buffer);\n    let floatView = new Float32Array(buffer);\n\n    // Set the integer value in the buffer\n    intView[0] = intVal;\n\n    // Interpret the buffer as a float\n    data = floatView[0].toFixed(2);\n} else {\n    // Parse data as a 32-bit unsigned integer otherwise\n    data = parseInt(dataStr, 16); // Parse as integer\n}\n\n// Construct the output object\nmsg.payload = {\n    dataID: dataID,  // Parsed data ID\n    data: data       // Parsed data (either integer or float)\n};\n\n// Return the modified message\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 303,
        "wires": [
