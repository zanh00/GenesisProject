    {
        "id": "cc6569cf15bbfe0e",
        "type": "function",
        "z": "80aeb0586fb10632",
        "name": "Serializer",
        "func": "// Input: msg.payload should be an object with the following structure:\n// {\n//     dataID: 5,      // Integer (0-255, 8-bit ID)\n//     data: 12345678  // Integer (32-bit data)\n// }\n\n// Extract the dataID and data\nlet dataID = msg.payload.dataID;  // e.g., 5\nlet data = msg.payload.data;      // e.g., 12345678\n\n// start byte\nlet startByte = 'Z'\n\n// Convert the dataID to a 2-character hexadecimal string (ASCII nibbles)\nlet dataIDHex = dataID.toString(16).padStart(2, '0').toUpperCase(); // \"05\"\n\n// Convert the data to an 8-character string\nlet dataStr = data.toString(16).padStart(8, '0').toUpperCase(); // \"12345678\"\n\n// Combine dataIDHex and dataStr into the final string\nmsg.payload = startByte + dataIDHex + dataStr; // \"0512345678\"\n\n// Return the modified message\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 320,
        "wires": [
            [
                "20a11a89087d66ab"
            ]
        ]
    },
