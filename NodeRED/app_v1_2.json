    {
        "id": "a130b33b2736fe59",
        "type": "function",
        "z": "4522ec776ef79fb7",
        "name": "Construct command flag",
        "func": "\n// Retrieve the current 32-bit value from the context (initialize to 0 if undefined)\nlet dataValue = context.get(\"dataValue\") || 0;\n\n// Check if the message includes a button update (msg.topic and msg.payload)\nif (msg.topic && msg.payload !== undefined) {\n    // Parse the byte position from the topic (convert string to integer)\n    let bytePos = parseInt(msg.topic);\n    let isPressed = msg.payload; // Get the button state (true/false)\n\n    // Update the 32-bit value based on the button state\n    if (isPressed) {\n        // Set the bit at the specified position\n        dataValue |= (1 << bytePos);\n    } else {\n        // Clear the bit at the specified position\n        dataValue &= ~(1 << bytePos);\n    }\n\n    // Save the updated 32-bit value back to the context\n    context.set(\"dataValue\", dataValue);\n}\n\n// Return the updated value in the message payload\nmsg.payload = {\n    dataID: 1,\n    data: dataValue\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 421,
